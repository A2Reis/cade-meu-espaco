{
  "name": "cade-meu-espaco",
  "version": "1.0.0",
  "description": "Analisador de disco pra Windows: mostra quais pastas e arquivos estão comendo o espaço",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "A2Reis",
  "homepage": "https://github.com/A2Reis/cade-meu-espaco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A2Reis/cade-meu-espaco.git"
  },
  "bugs": {
    "url": "https://github.com/A2Reis/cade-meu-espaco/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node cli.js",
    "test": "node --test",
    "fumaca": "electron tests/fumaca/app.js",
    "capturas": "electron tests/fumaca/app.js --demo",
    "icone": "electron scripts/gerar-icone.js",
    "empacotar": "electron-builder --win",
    "verificar-pacote": "node scripts/verificar-pacote.js"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "br.com.a2reis.cademeuespaco",
    "productName": "Cadê meu espaço",
    "executableName": "CadeMeuEspaco",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": null,
    "disableAsarIntegrity": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "ui/**"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icone.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cadê meu espaço",
      "runAfterFinish": true,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "deleteAppDataOnUninstall": true,
      "include": "build/instalador.nsh",
      "artifactName": "CadeMeuEspaco-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CadeMeuEspaco-Portatil-${version}.${ext}"
    }
  }
}
